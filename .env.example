# WhatsApp via Callmebot — https://www.callmebot.com/blog/free-api-whatsapp-messages/
# 1. Agregar +34 644 61 99 90 a tus contactos de WhatsApp como "CallMeBot"
# 2. Enviarle el mensaje: "I allow callmebot to send me messages"
# 3. Recibirás tu API key en minutos
CALLMEBOT_PHONE=549XXXXXXXXXX   # tu número con código de país (549 = Argentina), sin + ni espacios
CALLMEBOT_API_KEY=XXXXXX

# Opcional: override de ciudades objetivo (separadas por coma)
# TARGET_CITIES=buenos aires,caba,quilmes
